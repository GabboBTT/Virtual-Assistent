# Copia questo file in .env e compila i valori (il file .env è ignorato da git).

# Obbligatoria: trascrizione (https://console.deepgram.com → API Keys)
DEEPGRAM_API_KEY=

# Facoltativa: se vuota, le risposte passano da Claude Code con il tuo abbonamento
ANTHROPIC_API_KEY=

# Lingua dell'orale: en (default) o it
LINGUA=en

# Variante d'accento per Deepgram, es. en-IN, en-GB, en-US (facoltativa)
DEEPGRAM_LINGUA=

# Cartella con le soluzioni da discutere (facoltativa)
CARTELLA_SOLUZIONI=
